# Copy to .env for local development. Never commit .env.

# --- PostgreSQL (consumed by the db service in docker-compose.yml) ---
POSTGRES_USER=bmapp
POSTGRES_PASSWORD=bmapp
POSTGRES_DB=bmapp
# Host ports the compose stack publishes on 127.0.0.1. Override any that is
# already taken on your machine.
BMAPP_DB_PORT=5432
BMAPP_API_PORT=8000
BMAPP_WEB_PORT=5173

# --- Backend ---
# SQLAlchemy URL. Inside docker-compose the host is the service name "db";
# running the backend natively against the compose database, it is localhost.
BMAPP_DATABASE_URL=postgresql+psycopg://bmapp:bmapp@localhost:5432/bmapp
# Database the backend test suite creates and migrates. Must not be the dev one.
BMAPP_TEST_DATABASE_URL=postgresql+psycopg://bmapp:bmapp@localhost:5432/bmapp_test
# Address the API binds to. Localhost only: this application has no
# authentication yet and must not be reachable from another machine.
BMAPP_HOST=127.0.0.1
BMAPP_PORT=8000
BMAPP_LOG_LEVEL=INFO

# --- Identity ---
# How identity is established. "broker" (the default) accepts only tokens the
# identity broker signed; "dev" accepts only tokens this process signed and
# turns on the local login endpoint. The two never overlap, so a token minted
# in one is refused by the other.
#
# Dev mode is for local development only, and the server enforces that: it
# refuses to start when dev mode is combined with a configured identity
# broker, which every deployed environment configures. Set one or the other
# below, never both.
BMAPP_MODE=dev

# Broker mode only - leave these unset while BMAPP_MODE=dev, or the server
# will refuse to start.
#BMAPP_OIDC_ISSUER=https://identity.intra.pse.pl
#BMAPP_OIDC_CLIENT_ID=bmapp
# What a token must name as its audience. Leave empty to require the client id,
# which is what most brokers issue for a public client.
#BMAPP_OIDC_AUDIENCE=

# Administrators, comma-separated. They register teams and name their leaders.
# An empty list refuses every write that needs an administrator rather than
# permitting it, so at least one is needed before a team can be registered.
BMAPP_ADMIN_EMAILS=admin@example.com

# Origin the frontend dev server is served from, allowed through CORS.
BMAPP_FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend ---
# Where the Vite dev server forwards /api. The browser always calls /api on
# the dev server itself, so the page and the API share an origin.
VITE_API_PROXY_TARGET=http://localhost:8000
# Obtain the session from the backend's local login instead of the identity
# broker. The counterpart of BMAPP_MODE=dev; never set in a deployed build.
VITE_AUTH_MODE=dev
# Who the local login signs in as. Make it an administrator to be able to
# register a team.
VITE_DEV_EMAIL=admin@example.com
# Broker mode only: where the browser sends people to authenticate.
#VITE_OIDC_AUTHORITY=https://identity.intra.pse.pl
#VITE_OIDC_CLIENT_ID=bmapp

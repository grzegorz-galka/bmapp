# Demo image for Railway: unlike the development Dockerfile, it copies the
# code in, migrates on start and serves without --reload. Runs in dev mode
# only - see "Railway demo" in SECURITY.md for why that is acceptable there
# and nowhere else.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# Railway assigns the port. IPv4 is enough: the web app reaches the API on its
# public URL, never over the IPv6 private network.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

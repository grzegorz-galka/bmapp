# Demo image for Railway: builds the bundle and serves it as static files.
# The browser calls the API service directly on its own public URL (CORS is
# open to this origin through BMAPP_FRONTEND_ORIGIN), so nothing is proxied.
FROM node:24-slim AS build

# Vite inlines these at build time; Railway passes service variables as
# build arguments only when they are declared here.
ARG VITE_API_BASE_URL
ARG VITE_AUTH_MODE=dev
ARG VITE_DEV_EMAIL=admin@example.com

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.29-alpine
COPY nginx.railway.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
